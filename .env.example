DISCORD_TOKEN=your-bot-token
GUILD_ID=your-server-id
CHANNEL_ID=channel-for-notifications
OWNER_ID=your-user-id

SERVER_DIR=/root/server
RCON_CONFIG=/root/.rcon-cli.yaml

BACKUP_MODE=builtin
BACKUP_INTERVAL_MIN=15
BACKUP_ONLY_IF_PLAYERS=false
LOCAL_KEEP=96
WATCH_DIR=ftbbackups3
EXTERNAL_BACKUP_CMD="ftbbackups3 start"

RCLONE_REMOTE=gdrive:mc-backups
REMOTE_KEEP=12h

CONFIG_TARGETS=config,moddata,schematics,server.properties,whitelist.json,ops.json
CONFIG_EXCLUDES=config/fancymenu,config/spark
